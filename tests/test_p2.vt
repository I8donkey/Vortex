int x = 5;
print(x);
print([1, 2, 3]);
object a = [10, 20, 30];
print(a[1]);
int s = 0;
for (i in a) {
    s = s + i;
}
print(s);
object b = [];
b.append(7);
b.append(8);
print(b);
print(b[0]);
print(b[1] + 100);

# 内置 sum：数值列表求和
print(sum(a));
print(sum([1, 2, 3, 4, 5]));
print(sum([]));
object c = [2, -3, 4];
print(sum(c));

# 内置 prod：数值列表求积
print(prod([2, 3, 4]));
print(prod([1, 2, 3, 4, 5]));
print(prod([10, 0, 5]));
print(prod(a));
object d = [2, 3];
print(prod(d));