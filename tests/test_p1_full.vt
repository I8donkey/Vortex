import math;
# == 运算 ==
int a = 10;
int b = 3;
print(a + b);
print(a - b);
print(a * b);
print(a // b);
print(a % b);
print(2 ** 10);
print(a > b);
print(a <= b);
print(a == 10);
print(1 + 2 * 3);
# == 控制流 ==
if (a > b) { print(100); } else { print(200); }
if (a < b) { print(2); } elif (a == 10) { print(3); } else { print(4); }
int i = 0;
int s = 0;
while (i < 5) { s = s + i; i = i + 1; }
print(s);
int t = 0;
for (j in [1, 2, 3, 4]) { t = t + j; }
print(t);
# == 函数/递归 ==
def fact(n) {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}
print(fact(5));
# == 浮点 ==
float x = 3.5;
print(x + 1);
print(x * 2);
print(x);
print(7.0 // 2);
print(1.5 * 2);
# == 字符串 ==
str s5 = "hello";
print(s5);
str p = "he" + "llo";
print(p);
# == math ==
print(math.pow(2, 10));
print(math.sqrt(16));