import thread;
import log;

object counter = thread.atomic(0);
log.info("atomic init, get =", thread.atomic_get(counter));

def inc() {
    int i = 0;
    while (i < 100) {
        thread.atomic_add(counter, 1);
        i = i + 1;
    }
}

object a = thread.run(inc);
object b = thread.run(inc);
thread.join(a);
thread.join(b);
log.info("after 2x100 increments, counter =", thread.atomic_get(counter));
log.info("hardware cores =", thread.hardware());
log.info("atomic test done");
