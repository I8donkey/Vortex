# test_math.vt — math 模块：补齐编译端转发的函数（golden：解释器 vs 编译器）
import math;

print(math.cbrt(27.0));
print(math.cbrt(64.0));
print(math.exp(1.0));
print(math.log(1.0));
print(math.log(100.0, 10.0));
print(math.log2(8.0));
print(math.log10(1000.0));

# log1p / expm1 / erf / gamma / lgamma
print(math.log1p(0.0));
print(math.log1p(1.0));
print(math.expm1(0.0));
print(math.erf(0.0));
print(math.erf(1.0) > 0.8);
print(math.gamma(5.0));
print(math.lgamma(5.0) > 3.0);

print(math.sin(0.0));
print(math.cos(0.0));
print(math.tan(0.0));
print(math.atan2(1.0, 1.0));
print(math.hypot(3.0, 4.0));

print(math.sinh(0.0));
print(math.cosh(0.0));
print(math.tanh(0.0));

print(math.floor(3.9));
print(math.ceil(3.1));
print(math.trunc(-3.7));
print(math.round(3.14159));
print(math.round(2.567, 2));
print(math.fmod(7.5, 2.0));
print(math.fmin(3.0, 5.0));
print(math.fmax(3.0, 5.0));

print(math.gcd(48, 36));
print(math.lcm(4, 6));
print(math.gcd(17, 5));

# abs / min / max（int/float 感知）
print(math.abs(-5));
print(math.abs(-3.5));
print(math.min(3, 7));
print(math.max(3, 7));
print(math.min(2.5, 1.5));
print(math.max(-1.0, 2));
print(math.min(-2, -7));

# comb / perm
print(math.comb(5, 2));
print(math.comb(10, 3));
print(math.comb(0, 0));
print(math.perm(5, 2));
print(math.perm(5, 5));
print(math.comb(5, 7));

# radians / degrees / copysign / remainder
print(math.radians(180.0) > 3.1);
print(math.degrees(1.0) > 57.0);
print(math.copysign(3.0, -1.0));
print(math.copysign(-3.0, 1.0));
print(math.remainder(7.5, 2.0));

# factorial
print(math.factorial(0));
print(math.factorial(5));
print(math.factorial(10));

# isqrt
print(math.isqrt(0));
print(math.isqrt(1));
print(math.isqrt(16));
print(math.isqrt(20));
print(math.isqrt(99));

# isfinite / isclose（返回 0/1）
print(math.isfinite(1.0));
print(math.isfinite(math.sqrt(2.0)));
print(math.isclose(1.0, 1.0));
print(math.isclose(1.0, 1.00000000005));
print(math.isclose(1.0, 1.0001));
print(math.isclose(1.0, 1.0001, 0.001));
print(math.isclose(0.0, 0.000001, 0.01, 0.01));
print(math.isclose(0.0, 0.0001, 0.01, 0.0));

# 一致性
print(math.fabs(-5.0));
print(math.sqrt(9.0) == 3.0);

# 常量
print(math.pi);
print(math.e);
print(math.tau);
print(math.phi);
print(math.sqrt2);
print(math.ln2);
print(math.sin(math.pi / 2.0) == 1.0);
print(math.cos(math.pi) == -1.0);

print("done");